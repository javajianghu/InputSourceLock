    {
      "id": "config:LockChineseIME/Info.plist",
      "type": "config",
      "name": "Info.plist",
      "filePath": "LockChineseIME/Info.plist",
      "summary": "App Bundle 元数据：bundle ID com.tang.LockChineseIME、显示名「锁定中文输入法」、最低 macOS 13.0、Apple Silicon (arm64)、分类 utilities；关键权限声明 NSAccessibilityUsageDescription 说明 CGEventTap 用途。",
      "tags": [
        "configuration",
        "bundle-metadata",
        "permissions",
        "macos-app"
      ],
      "complexity": "simple"
    },
    {
      "id": "file:LockChineseIME/main.swift",
      "type": "file",
      "name": "main.swift",
      "filePath": "LockChineseIME/main.swift",
      "summary": "App 入口：创建 NSApplication、绑定 AppDelegate，注册 SIGINT 处理器以便开发期在终端运行时按 Ctrl+C 干净退出。",
      "tags": [
        "entry-point",
        "lifecycle",
        "signal-handler"
      ],
      "complexity": "simple"
    },
    {
      "id": "file:LockChineseIME/AppCore.swift",
      "type": "file",
      "name": "AppCore.swift",
      "filePath": "LockChineseIME/AppCore.swift",
      "summary": "App 的核心模块：包含 TIS 输入源查询 / 选中的全部 helper、StatusOverlayWindow（NSPanel 悬浮窗）、InputMethodManager（轮询 timer + 锁定重试 + CGEventTap Shift 检测 + 状态广播通知）。",
      "tags": [
        "core",
        "macos-app",
        "input-source",
        "event-tap",
        "state-machine"
      ],
      "complexity": "complex",
      "languageNotes": "CGEventTap 需要辅助功能权限；Shift 单独按下/释放才算中英文翻转（Shift+其他键不算），通过 keyDown 期间的 otherKeyUsedWhileShift 标志区分。"
    },
    {
      "id": "file:LockChineseIME/AppDelegate.swift",
      "type": "file",
      "name": "AppDelegate.swift",
      "filePath": "LockChineseIME/AppDelegate.swift",
      "summary": "NSApplicationDelegate：设为 .regular 激活策略（同时显示 Dock + 菜单栏）、启动 InputMethodManager 与 StatusBarController、首次启动自动弹出设置窗口、Dock 点击重新打开设置。",
      "tags": [
        "app-delegate",
        "lifecycle",
        "activation-policy"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:LockChineseIME/StatusBar.swift",
      "type": "file",
      "name": "StatusBar.swift",
      "filePath": "LockChineseIME/StatusBar.swift",
      "summary": "NSStatusItem 菜单栏控制器：动态切换 attributedTitle（红「中」/ 蓝「A」），菜单显示当前输入法 / 中英文模式 / 锁定状态，提供「打开设置…」(Cmd+,) 与「退出」(Cmd+Q)。",
      "tags": [
        "menu-bar",
        "status-item",
        "macos-app"
      ],
      "complexity": "moderate"
    },
    {
      "id": "file:LockChineseIME/Settings.swift",
      "type": "file",
      "name": "Settings.swift",
      "filePath": "LockChineseIME/Settings.swift",
      "summary": "设置窗口 NSWindowController：单页垂直滚动 + 6 张卡片（当前状态 / 锁定设置 / 悬浮窗 / 权限 / 开机启动 / 关于），辅助功能授权状态实时刷新，可一键跳转系统设置。",
      "tags": [
        "ui",
        "settings-window",
        "macos-app"
      ],
      "complexity": "complex"
    },
    {
      "id": "file:LockChineseIME/LaunchAtLogin.swift",
      "type": "file",
      "name": "LaunchAtLogin.swift",
      "filePath": "LockChineseIME/LaunchAtLogin.swift",
      "summary": "SMAppService.mainApp 的薄包装：isEnabled / enable / disable 三个静态方法，用于 macOS 13+ 开机自启注册。需 App 位于 /Applications 才能稳定工作。",
      "tags": [
        "launch-at-login",
        "service-management",
        "macos-app"
      ],
      "complexity": "simple"
    },
    {
      "id": "file:InputMethodStatus/main.swift",
      "type": "file",
      "name": "main.swift",
      "filePath": "InputMethodStatus/main.swift",
      "summary": "旧版单文件 CLI 实现：合并了悬浮窗 + 锁定功能，无 Dock / 菜单栏，参数为可选的输入法 ID；保留以供命令行用户使用。代码与 AppCore.swift 高度同构但独立成 binary。",
      "tags": [
        "legacy",
